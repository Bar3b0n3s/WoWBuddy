<Window x:Class="WoWBuddy.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WoWBuddy" Height="640" Width="920"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="8">

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Not attached." />
            </StatusBarItem>
        </StatusBar>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Client:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="ClientPicker" Width="420" VerticalAlignment="Center" />
            <Button x:Name="RefreshButton" Content="Refresh" Width="80" Margin="6,0,0,0"
                    Click="OnRefreshClicked" />
            <Button x:Name="AttachButton" Content="Attach" Width="80" Margin="6,0,0,0"
                    Click="OnAttachClicked" />
            <Button x:Name="DetachButton" Content="Detach" Width="80" Margin="6,0,0,0"
                    IsEnabled="False" Click="OnDetachClicked" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Offset verification" Margin="0,0,4,0">
                <TextBox x:Name="VerificationText"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="11"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Text="Attach to a client to verify the offset table against it." />
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Local player" Margin="4,0,0,0">
                <TextBox x:Name="PlayerText"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         Text="Not attached." />
            </GroupBox>
        </Grid>

    </DockPanel>
</Window>
