<Window x:Class="WoWBuddy.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WoWBuddy" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="8">

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding CharacterSummary}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Attaching -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Client:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="380" VerticalAlignment="Center"
                      ItemsSource="{Binding Clients}"
                      SelectedItem="{Binding SelectedClient}" />
            <Button Content="Refresh" Width="80" Margin="6,0,0,0" Command="{Binding RefreshCommand}" />
            <Button Content="Attach"  Width="80" Margin="6,0,0,0" Command="{Binding AttachCommand}" />
            <Button Content="Detach"  Width="80" Margin="6,0,0,0" Command="{Binding DetachCommand}" />

            <Button Content="Enable execution" Width="120" Margin="6,0,0,0"
                    Command="{Binding EnableExecutionCommand}"
                    ToolTip="Attaching only reads the client. This lets the bot act on it." />

            <Separator Margin="12,0" />

            <Button Content="Start" Width="80" Command="{Binding StartCommand}"
                    ToolTip="{Binding StartBlockedReason}" />
            <Button Content="Stop"  Width="80" Margin="6,0,0,0" Command="{Binding StopCommand}" />
        </StackPanel>

        <!-- What to play -->
        <GroupBox DockPanel.Dock="Top" Header="What to play" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Bot base:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Column="1" VerticalAlignment="Center"
                          ItemsSource="{Binding BotBases}"
                          SelectedItem="{Binding SelectedBotBase}"
                          DisplayMemberPath="Name"
                          ToolTip="{Binding SelectedBotBase.Description}" />

                <TextBlock Grid.Column="2" Text="Routine:" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox Grid.Column="3" VerticalAlignment="Center"
                          ItemsSource="{Binding Routines}"
                          SelectedItem="{Binding SelectedRoutine}"
                          DisplayMemberPath="Name" />

                <TextBlock Grid.Column="4" Text="Profile:" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Grid.Column="5" VerticalAlignment="Center"
                         Text="{Binding ProfilePath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="6" Content="Browse..." Width="80" Margin="6,0,0,0"
                        Click="OnBrowseProfileClicked" />
            </Grid>
        </GroupBox>

        <!-- Reports -->
        <TabControl>
            <TabItem Header="Log">
                <ListBox ItemsSource="{Binding Log.Lines}"
                         FontFamily="Consolas" FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </TabItem>

            <TabItem Header="Offset verification">
                <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Text="{Binding VerificationReport, Mode=OneWay}" />
            </TabItem>

            <TabItem Header="Client capabilities">
                <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Text="{Binding ClientCapabilities, Mode=OneWay}" />
            </TabItem>

            <TabItem Header="Profile">
                <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Text="{Binding ProfileReport, Mode=OneWay}" />
            </TabItem>

            <TabItem Header="Plugins">
                <DataGrid ItemsSource="{Binding Plugins}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"    Binding="{Binding Plugin.Name}"    Width="180" />
                        <DataGridTextColumn Header="Author"  Binding="{Binding Plugin.Author}"  Width="140" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Plugin.Version}" Width="80" />
                        <DataGridTextColumn Header="State"   Binding="{Binding State}"          Width="80" />
                        <DataGridTextColumn Header="Last error" Binding="{Binding LastError}"   Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
