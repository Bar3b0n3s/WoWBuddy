<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WoWBuddy.Inspector</RootNamespace>
    <AssemblyName>WoWBuddy.Inspector</AssemblyName>
    <!-- Attaches to the 32-bit client, so the host process is built x86. -->
