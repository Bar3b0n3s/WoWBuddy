  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Common\WoWBuddy.Common.csproj" />
    <ProjectReference Include="..\..\src\Core\WoWBuddy.Core.csproj" />
    <ProjectReference Include="..\..\src\GameApi\WoWBuddy.GameApi.csproj" />
    <ProjectReference Include="..\..\src\Navigation\WoWBuddy.Navigation.csproj" />
    <ProjectReference Include="..\..\src\Profiles\WoWBuddy.Profiles.csproj" />
    <ProjectReference Include="..\..\src\WorldData\WoWBuddy.WorldData.csproj" />
  </ItemGroup>

</Project>
