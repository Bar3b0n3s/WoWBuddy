<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Licence policy: only permissive licences (MIT / BSD / Apache-2.0 / zlib) may
    be referenced. Anything copyleft is a build-breaking mistake, not a warning.
    See docs/legal-and-licensing.md.
  -->
  <ItemGroup>
    <!-- Serilog and sinks: Apache-2.0 -->
    <PackageVersion Include="Serilog" Version="4.1.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- Microsoft.Extensions.*: MIT -->
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="8.0.11" />
    <!--
      DotRecast: a C# port of Recast/Detour, zlib licensed like the original. Used to read
      the navigation meshes the user extracts from their own client and to query paths in
      them. Being permissive is what makes it usable here: the obvious alternative,
      AmeisenNavigation, is GPL-3.0 and could not be linked into an MIT program.
    -->
    <PackageVersion Include="DotRecast.Detour" Version="2026.3.1" />
    <PackageVersion Include="DotRecast.Core" Version="2026.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only. xunit: Apache-2.0. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
